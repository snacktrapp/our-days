{
  "expo": {
    "name": "Our Days",
    "slug": "our-days",
    "scheme": "ourdays",
    "version": "0.5.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101216",
    "ios": {
      "bundleIdentifier": "com.snacktrapp.ourdays",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.snacktrapp.ourdays",
      "adaptiveIcon": {
        "backgroundColor": "#101216",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Our Days uses your photo library so you can add pictures and videos to your family journal.",
          "cameraPermission": "Our Days uses the camera so you can take a picture or video for your family journal.",
          "microphonePermission": "Our Days uses the microphone so a video you record for your family includes sound."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Our Days uses your location while you add a place, so your family journal can name where you are.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Our Days does not track your movement. iOS asks for this notice because the location tools used to name a place include motion support.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Add to Our Days",
          "disableAndroid": true,
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "beelinetech",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df91faac-3cbe-4544-bc59-1849757d20fe"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/df91faac-3cbe-4544-bc59-1849757d20fe"
    }
  }
}
