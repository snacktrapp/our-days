# This project must use resources dedicated to Our Days. Never reuse Proof,
# LiftSync, or Bee Line Tech values. Account map and where each variable is
# set: docs/operations/ACCOUNT_AND_ENV.md. Do not paste secrets into chat.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OUR_DAYS_ENVIRONMENT=local
OUR_DAYS_RESOURCE_MODE=detached
OUR_DAYS_ENABLE_DESIGN_PREVIEW=false
OUR_DAYS_LOCAL_JOURNAL_MODE=enabled
OUR_DAYS_INVITATION_DELIVERY_MODE=disabled
OUR_DAYS_MEDIA_DELIVERY_MODE=disabled
OUR_DAYS_PHOTO_POSTING_MODE=disabled
OUR_DAYS_PRODUCTION_SITE_ORIGIN=
OUR_DAYS_EXPECTED_SUPABASE_PROJECT_REF=
OUR_DAYS_PRODUCTION_SUPABASE_PROJECT_REF=
OUR_DAYS_FORBIDDEN_SUPABASE_PROJECT_REFS=

# Optional first-party Google / X sign-in. Leave empty until Brian creates
# the OAuth apps. See docs/operations/OAUTH_SIGN_IN.md. OAuth is identity
# only; an uninvited account still cannot open a family journal.
OUR_DAYS_GOOGLE_CLIENT_ID=
OUR_DAYS_GOOGLE_CLIENT_SECRET=
OUR_DAYS_X_CLIENT_ID=
OUR_DAYS_X_CLIENT_SECRET=
OUR_DAYS_OAUTH_STATE_SECRET=

# Added only after the separate Supabase project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials for a dedicated Supabase Auth validator identity.
# This account must be allowlisted by the photo migrations and must never have
# a family membership. These values must never use a NEXT_PUBLIC_ prefix.
OUR_DAYS_PHOTO_WORKER_EMAIL=
OUR_DAYS_PHOTO_WORKER_PASSWORD=

# This web-app environment intentionally has no Supabase secret/service-role key.
# It also has no direct database URL, password, or JWT secret.
# A separately deployed worker receives that bypass credential only after its
# import boundary, artifact scan, and resource isolation are implemented.
