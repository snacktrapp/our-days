{
  "name": "our-days",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run verify:artifacts",
    "build:webpack": "next build --webpack && npm run verify:artifacts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "format": "prettier --write \"config/**/*.ts\" \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts,json}\"",
    "format:check": "prettier --check \"config/**/*.ts\" \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:webpack && playwright test",
    "test:e2e:update": "npm run build:webpack && playwright test --update-snapshots",
    "test:e2e:local-journal": "npm run build:webpack && playwright test -c playwright.local-journal.config.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --project-id our-days",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "test:db": "supabase test db --local supabase/tests/database",
    "test:db:concurrency": "node scripts/test-database-concurrency.mjs",
    "test:photo:concurrency": "node scripts/test-photo-intake-concurrency.mjs",
    "test:photo:derivative:concurrency": "node scripts/test-photo-derivative-concurrency.mjs",
    "test:db:restore": "node scripts/test-local-logical-restore.mjs",
    "test:db:restore:self": "node scripts/test-local-logical-restore.mjs --self-test",
    "test:auth:integration": "node scripts/test-auth-integration.mjs",
    "test:invitation:integration": "OUR_DAYS_LOCAL_INVITATION_INTEGRATION=1 vitest run tests/integration/invitation-delivery.local.test.ts --testTimeout=120000 --hookTimeout=120000",
    "test:photo:integration": "node scripts/test-photo-intake-integration.mjs",
    "test:browser:connected": "node scripts/test-connected-browser-flow.mjs",
    "test:browser:connected:all": "node scripts/test-connected-browser-matrix.mjs",
    "types:db": "supabase gen types --local --lang typescript --schema public | prettier --parser typescript > src/lib/supabase/database.types.ts",
    "types:db:check": "node scripts/verify-database-types.mjs",
    "verify:artifacts": "node scripts/verify-private-artifacts.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:db:restore:self",
    "release:state": "node scripts/verify-release-state.mjs",
    "release:verify": "npm run release:state && npm run check && npm run build:webpack && playwright test --grep-invert @visual"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "maplibre-gl": "6.7.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
